{
	"name": "server",
	"version": "1.0.0",
	"description": "Expense tracker API",
	"type": "module",
	"main": "src/server.ts",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"start:ci": "tsx src/server.ts",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.9",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.2.0",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.3.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
